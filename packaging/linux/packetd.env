# Environment for nyxr-packetd.service. Edit, then:
#   sudo systemctl enable --now nyxr-packetd
# Clients connect to /run/nyxr/packetd.sock and must be in the nyxr group.

# Comma-separated interfaces packetd may open (required).
NYXR_PACKETD_INTERFACES=eth0

# Extra flags, e.g. --max-pps 1000 --max-clients 4
NYXR_PACKETD_OPTS=--max-pps 1000
