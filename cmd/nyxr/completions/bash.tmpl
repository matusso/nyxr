# bash completion for nyxr
#
# Load in the current shell:   source <(nyxr completion bash)
# Load for every new shell:    nyxr completion bash > ~/.local/share/bash-completion/completions/nyxr

_nyxr() {
    local cur prev cmd sub i seen
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"

    # "--flag=value": readline splits on "=", so look one word further back.
    if [[ "$cur" == "=" ]]; then
        cur=""
    fi
    if [[ "$prev" == "=" && $COMP_CWORD -ge 2 ]]; then
        prev="${COMP_WORDS[COMP_CWORD-2]}"
    fi

    cmd=""
    sub=""
    seen=0
    for ((i = 1; i < COMP_CWORD; i++)); do
        case "${COMP_WORDS[i]}" in
            -*) ;;
            *)
                if [[ -z "$cmd" ]]; then
                    cmd="${COMP_WORDS[i]}"
                elif [[ $seen -eq 0 ]]; then
                    sub="${COMP_WORDS[i]}"; seen=1
                fi ;;
        esac
    done

    if [[ -z "$cmd" ]]; then
        COMPREPLY=($(compgen -W "scan profiles decode sniff history probe horizon serve completion version help" -- "$cur"))
        return 0
    fi

    case "$cmd" in
        scan)
            case "$prev" in
                --profile|-profile)
                    COMPREPLY=($(compgen -W "{{range .Profiles}}{{.Name}} {{end}}" -- "$cur"))
                    return 0 ;;
                --ports|-ports)
                    COMPREPLY=($(compgen -W "{{join .PortSets " "}}" -- "$cur"))
                    return 0 ;;
                --protocols|-protocols)
                    COMPREPLY=($(compgen -W "tcp udp icmp tcp,udp tcp,icmp udp,icmp tcp,udp,icmp" -- "$cur"))
                    return 0 ;;
                --tcp-mode|-tcp-mode)
                    COMPREPLY=($(compgen -W "connect syn" -- "$cur"))
                    return 0 ;;
                --interface|-interface)
                    COMPREPLY=($(compgen -W "$(command ls /sys/class/net 2>/dev/null || ifconfig -l 2>/dev/null)" -- "$cur"))
                    return 0 ;;
                --service-probes|-service-probes)
                    COMPREPLY=($(compgen -W "banner ssh tls http dns socks modbus ethernetip nmap banner,ssh,tls,http,dns,socks modbus,ethernetip" -- "$cur"))
                    return 0 ;;
                --service-fallback|-service-fallback)
                    COMPREPLY=($(compgen -W "http tls,http none" -- "$cur"))
                    return 0 ;;
                --payload|-payload|--config|-config|--payload-file|-payload-file|--nmap-udp-probes|-nmap-udp-probes|--nmap-service-probes|-nmap-service-probes|--protocol-definitions|-protocol-definitions|--pcapng|-pcapng|--db|-db|--packetd|-packetd)
                    COMPREPLY=($(compgen -f -- "$cur"))
                    return 0 ;;
                --timeout|-timeout|--rate|-rate|--workers|-workers|--udp-retries|-udp-retries|--send-hex|-send-hex|--send-base64|-send-base64|--source-ip|-source-ip|--source-mac|-source-mac|--next-hop-mac|-next-hop-mac|--allow-targets|-allow-targets|--service-timeout|-service-timeout|--service-workers|-service-workers|--service-rate|-service-rate|--nse-scripts|-nse-scripts|--nse-timeout|-nse-timeout|--pcapng-max-mb|-pcapng-max-mb)
                    return 0 ;;
            esac
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "--profile --ports --protocols --timeout --rate --workers --udp-retries --tcp-mode --interface --source-ip --source-mac --next-hop-mac --allow-targets --payload --send-hex --send-base64 --payload-file --nmap-udp-probes --config --service --service-probes --service-fallback --service-timeout --service-workers --service-rate --nmap-service-probes --protocol-definitions --nse-scripts --nse-timeout --pcapng --pcapng-max-mb --no-last-pcapng --db --no-db --fingerprint --packetd --known-open --json --dry-run --help" -- "$cur"))
            fi
            ;;
        horizon)
            case "$prev" in
                --policy) COMPREPLY=($(compgen -W "lab enterprise fragile ot-restricted" -- "$cur")); return 0 ;;
                --permit) COMPREPLY=($(compgen -W "cross-port" -- "$cur")); return 0 ;;
                --simulate) COMPREPLY=($(compgen -W "sack stable loss noise" -- "$cur")); return 0 ;;
                --experiment|--output|--packetd|--pcapng) COMPREPLY=($(compgen -f -- "$cur")); return 0 ;;
                --allow-targets|--allow-ports|--target|--ports|--interface|--source-ip|--source-mac|--next-hop-mac|--pcapng-max-bytes) return 0 ;;
            esac
            if [[ -z "$sub" ]]; then
                COMPREPLY=($(compgen -W "resolve replay explain references verify-capture" -- "$cur"))
            elif [[ "$sub" == "resolve" ]]; then
                COMPREPLY=($(compgen -W "--experiment --policy --permit --allow-targets --allow-ports --target --ports --dry-run --simulate --interface --source-ip --source-mac --next-hop-mac --packetd --output --pcapng --pcapng-max-bytes --pcapng-minimize --help" -- "$cur"))
            else
                COMPREPLY=($(compgen -f -- "$cur"))
            fi
            ;;
        probe)
            if [[ "$sub" == "import" || "$sub" == "validate" ]]; then
                if [[ "$cur" == -* ]]; then
                    COMPREPLY=($(compgen -W "--json --help" -- "$cur"))
                else
                    COMPREPLY=($(compgen -f -- "$cur"))
                fi
            else
                COMPREPLY=($(compgen -W "import validate" -- "$cur"))
            fi
            ;;
        profiles)
            COMPREPLY=($(compgen -W "--json" -- "$cur"))
            ;;
        decode)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "--last --tui --all --packets --json" -- "$cur"))
            else
                COMPREPLY=($(compgen -f -- "$cur"))
            fi
            ;;
        sniff)
            case "$prev" in
                --interface|-interface)
                    COMPREPLY=($(compgen -W "$(command ls /sys/class/net 2>/dev/null || ifconfig -l 2>/dev/null)" -- "$cur"))
                    return 0 ;;
                --count|-count|--timeout|-timeout)
                    return 0 ;;
            esac
            COMPREPLY=($(compgen -W "--interface --count --timeout" -- "$cur"))
            ;;
        history)
            case "$prev" in
                --db|-db|--import-pcap|--import-identifiers|--kube-token-file|--kube-ca-file)
                    COMPREPLY=($(compgen -f -- "$cur"))
                    return 0 ;;
                --scan|-scan|--address|-address|--limit|-limit|--prune-older-than|-prune-older-than|--keep|-keep|--kube-api|--kube-cluster-scope)
                    return 0 ;;
            esac
			COMPREPLY=($(compgen -W "--db --scan --assets --identities --identity-events --topology --import-pcap --import-identifiers --kube-api --kube-token-file --kube-ca-file --kube-cluster-scope --capture-interface --open --scope --unknown --address --limit --prune-older-than --keep --json --help" -- "$cur"))
            ;;
        serve)
            case "$prev" in
                --db|-db|--packetd|-packetd|--evidence-dir|-evidence-dir|--token-file|-token-file)
                    COMPREPLY=($(compgen -f -- "$cur"))
                    return 0 ;;
                --listen|-listen|--max-scans|-max-scans)
                    return 0 ;;
            esac
            COMPREPLY=($(compgen -W "--listen --db --packetd --evidence-dir --token-file --max-scans --horizon-simulate --horizon-policy --horizon-allow-targets --horizon-allow-ports --horizon-permit --allow-privileged --help" -- "$cur"))
            ;;
        completion)
            if [[ $COMP_CWORD -eq $((i + 1)) ]]; then
                COMPREPLY=($(compgen -W "bash zsh fish powershell" -- "$cur"))
            fi
            ;;
    esac
    return 0
}

complete -o filenames -F _nyxr nyxr
