#compdef nyxr
# zsh completion for nyxr
#
# Load in the current shell:   source <(nyxr completion zsh)
# Load for every new shell:    nyxr completion zsh > "${fpath[1]}/_nyxr"

_nyxr_profiles() {
    local -a profiles
    profiles=(
{{- range .Profiles}}
        {{sh (printf "%s:%s" .Name .Description)}}
{{- end}}
    )
    _describe -t profiles 'scan profile' profiles
}

_nyxr_ports() {
    _values -s , 'port set' {{join .PortSets " "}}
}

_nyxr() {
    local curcontext="$curcontext" state line ret=1
    typeset -A opt_args

    _arguments -C \
        '1: :->command' \
        '*:: :->args' && ret=0

    case $state in
        command)
            local -a commands
            commands=(
                'scan:run a scan'
                'profiles:list scan profiles'
                'decode:summarize hosts and open ports in a pcap or pcapng'
                'sniff:capture and decode live frames'
                'history:list or query stored scans, assets and evidence'
                'probe:import and summarize an nmap-service-probes file'
                'horizon:bounded HZ-001 experiments and offline evidence replay'
                'serve:serve the REST API and web UI'
                'completion:print a shell completion script'
                'version:print the version'
                'help:show help'
            )
            _describe -t commands 'nyxr command' commands && ret=0
            ;;
        args)
            case $line[1] in
                scan)
                    _arguments \
                        '--profile=[scan profile]:profile:_nyxr_profiles' \
                        '--ports=[ports, ranges, or a named set]:ports:_nyxr_ports' \
                        '--protocols=[comma list of protocols]:protocols:_values -s , protocol tcp udp icmp' \
                        '--timeout=[per-probe timeout]:duration (e.g. 1s, 750ms):' \
                        '--rate=[max probes per second (0 = unlimited)]:rate:' \
                        '--workers=[concurrent probe workers]:workers:' \
                        '--udp-retries=[extra retries per UDP probe]:retries:(0 1 2 3 4 5)' \
                        '--tcp-mode=[TCP scan method]:mode:(connect syn)' \
                        '--interface=[Ethernet interface]:interface:_net_interfaces' \
                        '--source-ip=[source IPv4 address]:source IP:' \
                        '--source-mac=[source Ethernet MAC]:source MAC:' \
                        '--next-hop-mac=[destination or gateway MAC]:next-hop MAC:' \
                        '--payload=[native YAML UDP probe definition]:probe file:_files -g "*.(yaml|yml)"' \
                        '--send-hex=[custom UDP payload as hex]:hex:' \
                        '--send-base64=[custom UDP payload as base64]:base64:' \
                        '--payload-file=[custom raw UDP payload file]:payload file:_files' \
                        '--nmap-udp-probes=[add UDP payloads from Nmap probe file]:probes file:_files' \
                        '--config=[YAML scan configuration]:config file:_files -g "*.(yaml|yml)"' \
                        '--service[deep service probes on open TCP ports]' \
                        '--service-probes=[comma list of service probes]:probes:_values -s , probe banner ssh tls http dns socks modbus ethernetip nmap database' \
                        '--allow-targets=[approved IPs or CIDRs]:allow targets:' \
                        '--service-fallback=[probes for unhinted silent ports, or none]:fallback:(http tls,http none)' \
                        '--service-timeout=[upper bound for each service probe]:duration (e.g. 3s):' \
                        '--service-workers=[concurrent service probe workers]:workers:' \
                        '--service-rate=[new service connections per second (0 = unlimited)]:rate:' \
                        '--nmap-service-probes=[import an nmap-service-probes file for banner matching]:probes file:_files' \
                        '--protocol-definitions=[local Nyxr Protocol DSL files]:protocol files:_files -g "*.(yaml|yml)"' \
                        '--nse-scripts=[comma list of installed safe NSE scripts]:scripts:' \
                        '--nse-timeout=[maximum Nmap time per host]:duration (e.g. 30s):' \
                        '--pcapng=[write packet evidence to a pcapng file]:pcapng file:_files -g "*.pcapng"' \
                        '--pcapng-max-mb=[pcapng size budget in MiB]:MiB:' \
                        '--db=[SQLite database (default ~/.nyxr/nyxr.db)]:database file:_files' \
                        '--no-last-pcapng[do not keep this scan in ~/.nyxr/last.pcapng]' \
                        '--no-db[do not store the scan]' \
                        '--json[newline-delimited JSON output]' \
                        '--dry-run[resolve and print the plan without sending packets]' \
                        '--fingerprint[classify devices from independent observations]' \
                        '--packetd=[raw packet I/O through nyxr-packetd]:socket:_files' \
                        '--known-open[rescan only ports the database last saw open]' \
                        '(- *)--help[show scan help]' \
                        '*:target (IP, hostname, CIDR, or A-B range):_hosts' && ret=0
                    ;;
                profiles)
                    _arguments '--json[JSON output]' && ret=0
                    ;;
                decode)
                    _arguments \
                        '--last[decode the last scan capture, ~/.nyxr/last.pcapng]' \
                        '--tui[browse and inspect packets interactively]' \
                        '--all[also list closed and filtered ports]' \
                        '--packets[list every decoded packet]' \
                        '--json[one JSON object per decoded packet]' \
                        '1:pcap or pcapng file:_files -g "*.(pcap|cap|pcapng)"' && ret=0
                    ;;
                sniff)
                    _arguments \
                        '--interface=[network interface]:interface:_net_interfaces' \
                        '--count=[number of decoded packets]:count:' \
                        '--timeout=[capture duration]:duration (e.g. 10s):' && ret=0
                    ;;
                history)
                    _arguments \
                        '--db=[SQLite database written by nyxr scan]:database file:_files' \
                        '--scan=[print the observations and packet evidence of one scan]:scan id:' \
                        '--assets[print every address with the latest state of each port]' \
						'--identities[group addresses by strong device identity signals]' \
						'--identity-events[show identity membership audit]' \
						'--topology[show imported LLDP neighbors]' \
						'--import-pcap=[import passive pcap or pcapng]:capture file:_files' \
						'--import-identifiers=[import scoped inventory IDs]:JSON file:_files' \
						'--kube-api=[Kubernetes API HTTPS origin]:URL:' \
						'--kube-token-file=[Kubernetes bearer token file]:token file:_files' \
						'--kube-ca-file=[Kubernetes CA PEM file]:CA file:_files' \
						'--kube-cluster-scope=[stable Kubernetes cluster scope]:scope:' \
						'--capture-interface=[source interface for capture import]:interface:' \
                        '--unknown[print service observations with an unknown fingerprint]' \
                        '--address=[restrict --scan or --unknown to one address]:address:' \
						'--open[with --assets or --identities, keep open ports]' \
						'--scope=[with --assets or --identities, select matching addresses]:scope:' \
                        '--limit=[maximum scans or observations]:limit:' \
                        '--prune-older-than=[delete scans older than this duration]:duration (e.g. 720h):' \
                        '--keep=[delete all but the newest N scans]:count:' \
                        '--json[JSON output]' \
                        '(- *)--help[show history help]' && ret=0
                    ;;
                serve)
                    _arguments \
                        '--listen=[listen address]:address (host\:port):' \
                        '--db=[SQLite database for scans and results]:database file:_files' \
                        '--packetd=[nyxr-packetd Unix socket]:socket:_files' \
                        '--evidence-dir=[directory for API pcapng captures]:directory:_directories' \
                        '--token-file=[require this bearer token]:token file:_files' \
                        '--max-scans=[concurrent scans]:count:' \
                        '--allow-privileged[run even with root or raw-socket capabilities]' \
                        '(- *)--help[show serve help]' && ret=0
                    ;;
                horizon)
                    _arguments \
                        '1:subcommand:(resolve replay explain references)' \
                        '--experiment=[versioned experiment]:file:_files' \
                        '--allow-targets=[authorized IP/CIDR scope]:scope:' \
                        '--allow-ports=[authorized TCP ports]:ports:' \
                        '--target=[assert experiment target]:IP:' \
                        '--ports=[assert experiment port]:port:' \
                        '--dry-run[compile without packet I/O]' \
                        '--simulate=[synthetic scenario]:scenario:(sack stable loss noise)' \
                        '--interface=[live Ethernet interface]:interface:_net_interfaces' \
                        '--source-ip=[assigned source IP]:IP:' \
                        '--source-mac=[source Ethernet MAC]:MAC:' \
                        '--next-hop-mac=[target or gateway MAC]:MAC:' \
                        '--packetd=[packet daemon socket]:socket:_files' \
                        '--output=[new private evidence file]:file:_files' \
                        '*:report file:_files' && ret=0
                    ;;
                probe)
                    _arguments \
                        '1:subcommand:(import validate)' \
                        '--json[machine-readable summary]' \
                        '*:probe file:_files' && ret=0
                    ;;
                completion)
                    _arguments '1:shell:(bash zsh fish powershell)' && ret=0
                    ;;
            esac
            ;;
    esac
    return ret
}

if [[ "$funcstack[1]" == "_nyxr" ]]; then
    _nyxr "$@"
else
    compdef _nyxr nyxr
fi
