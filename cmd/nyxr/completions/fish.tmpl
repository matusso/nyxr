# fish completion for nyxr
#
# Load in the current shell:   nyxr completion fish | source
# Load for every new shell:    nyxr completion fish > ~/.config/fish/completions/nyxr.fish

function __nyxr_profiles
{{- range .Profiles}}
    printf '%s\t%s\n' {{fish .Name}} {{fish .Description}}
{{- end}}
end

set -l __nyxr_commands scan profiles decode sniff history probe serve completion version help
complete -c nyxr -f

complete -c nyxr -n "not __fish_seen_subcommand_from $__nyxr_commands" -a scan -d 'Run a scan'
complete -c nyxr -n "not __fish_seen_subcommand_from $__nyxr_commands" -a profiles -d 'List scan profiles'
complete -c nyxr -n "not __fish_seen_subcommand_from $__nyxr_commands" -a decode -d 'Decode an Ethernet pcap or pcapng to JSON'
complete -c nyxr -n "not __fish_seen_subcommand_from $__nyxr_commands" -a sniff -d 'Capture and decode live frames'
complete -c nyxr -n "not __fish_seen_subcommand_from $__nyxr_commands" -a history -d 'List or query stored scans, assets and evidence'
complete -c nyxr -n "not __fish_seen_subcommand_from $__nyxr_commands" -a probe -d 'Import and summarize an nmap-service-probes file'
complete -c nyxr -n "not __fish_seen_subcommand_from $__nyxr_commands" -a serve -d 'Serve the REST API and web UI'
complete -c nyxr -n "not __fish_seen_subcommand_from $__nyxr_commands" -a completion -d 'Print a shell completion script'
complete -c nyxr -n "not __fish_seen_subcommand_from $__nyxr_commands" -a version -d 'Print the version'
complete -c nyxr -n "not __fish_seen_subcommand_from $__nyxr_commands" -a help -d 'Show help'

# scan
complete -c nyxr -n '__fish_seen_subcommand_from scan' -l profile -x -a '(__nyxr_profiles)' -d 'Scan profile'
complete -c nyxr -n '__fish_seen_subcommand_from scan' -l ports -x -a {{fish (join .PortSets " ")}} -d 'Ports, ranges, or a named set'
complete -c nyxr -n '__fish_seen_subcommand_from scan' -l protocols -x -a 'tcp udp icmp tcp,udp tcp,icmp udp,icmp tcp,udp,icmp' -d 'Comma list of protocols'
complete -c nyxr -n '__fish_seen_subcommand_from scan' -l timeout -x -d 'Per-probe timeout (e.g. 1s, 750ms)'
complete -c nyxr -n '__fish_seen_subcommand_from scan' -l rate -x -d 'Max probes per second (0 = unlimited)'
complete -c nyxr -n '__fish_seen_subcommand_from scan' -l workers -x -d 'Concurrent probe workers'
complete -c nyxr -n '__fish_seen_subcommand_from scan' -l udp-retries -x -a '0 1 2 3 4 5' -d 'Extra retries per UDP probe'
complete -c nyxr -n '__fish_seen_subcommand_from scan' -l tcp-mode -x -a 'connect syn' -d 'TCP scan method'
complete -c nyxr -n '__fish_seen_subcommand_from scan' -l interface -x -a '(__fish_print_interfaces)' -d 'Ethernet interface'
complete -c nyxr -n '__fish_seen_subcommand_from scan' -l source-ip -x -d 'Source IPv4 address'
complete -c nyxr -n '__fish_seen_subcommand_from scan' -l source-mac -x -d 'Source Ethernet MAC'
complete -c nyxr -n '__fish_seen_subcommand_from scan' -l next-hop-mac -x -d 'Destination or gateway MAC'
complete -c nyxr -n '__fish_seen_subcommand_from scan' -l payload -r -F -d 'Native YAML UDP probe definition'
complete -c nyxr -n '__fish_seen_subcommand_from scan' -l send-hex -x -d 'Custom UDP payload as hex'
complete -c nyxr -n '__fish_seen_subcommand_from scan' -l send-base64 -x -d 'Custom UDP payload as base64'
complete -c nyxr -n '__fish_seen_subcommand_from scan' -l payload-file -r -F -d 'Custom raw UDP payload file'
complete -c nyxr -n '__fish_seen_subcommand_from scan' -l config -r -F -d 'YAML scan configuration'
complete -c nyxr -n '__fish_seen_subcommand_from scan' -l service -d 'Deep service probes on open TCP ports'
complete -c nyxr -n '__fish_seen_subcommand_from scan' -l service-probes -x -a 'banner ssh tls http dns modbus ethernetip nmap banner,ssh,tls,http,dns modbus,ethernetip' -d 'Comma list of service probes'
complete -c nyxr -n '__fish_seen_subcommand_from scan' -l allow-targets -x -d 'Approved IPs or CIDRs'
complete -c nyxr -n '__fish_seen_subcommand_from scan' -l service-fallback -x -a 'http tls,http none' -d 'Probes for unhinted silent ports, or none'
complete -c nyxr -n '__fish_seen_subcommand_from scan' -l service-timeout -x -d 'Upper bound for each service probe'
complete -c nyxr -n '__fish_seen_subcommand_from scan' -l service-workers -x -d 'Concurrent service probe workers'
complete -c nyxr -n '__fish_seen_subcommand_from scan' -l service-rate -x -d 'New service connections per second (0 = unlimited)'
complete -c nyxr -n '__fish_seen_subcommand_from scan' -l nmap-service-probes -r -F -d 'Import an nmap-service-probes file for banner matching'
complete -c nyxr -n '__fish_seen_subcommand_from scan' -l pcapng -r -F -d 'Write packet evidence to a pcapng file'
complete -c nyxr -n '__fish_seen_subcommand_from scan' -l pcapng-max-mb -x -d 'Pcapng size budget in MiB'
complete -c nyxr -n '__fish_seen_subcommand_from scan' -l db -r -F -d 'Store results in a SQLite database'
complete -c nyxr -n '__fish_seen_subcommand_from scan' -l json -d 'Newline-delimited JSON output'
complete -c nyxr -n '__fish_seen_subcommand_from scan' -l dry-run -d 'Print the plan without sending packets'
complete -c nyxr -n '__fish_seen_subcommand_from scan' -l fingerprint -d 'Classify devices from independent observations'
complete -c nyxr -n '__fish_seen_subcommand_from scan' -l packetd -r -F -d 'Raw packet I/O through nyxr-packetd'
complete -c nyxr -n '__fish_seen_subcommand_from scan' -l help -d 'Show scan help'

# profiles
complete -c nyxr -n '__fish_seen_subcommand_from profiles' -l json -d 'JSON output'

# decode
complete -c nyxr -n '__fish_seen_subcommand_from decode' -F

# sniff
complete -c nyxr -n '__fish_seen_subcommand_from sniff' -l interface -x -a '(__fish_print_interfaces)' -d 'Network interface'
complete -c nyxr -n '__fish_seen_subcommand_from sniff' -l count -x -d 'Number of decoded packets'
complete -c nyxr -n '__fish_seen_subcommand_from sniff' -l timeout -x -d 'Capture duration'

# probe
complete -c nyxr -n '__fish_seen_subcommand_from probe; and not __fish_seen_subcommand_from import' -a import -d 'Import and summarize an nmap-service-probes file'
complete -c nyxr -n '__fish_seen_subcommand_from probe; and __fish_seen_subcommand_from import' -l json -d 'Machine-readable summary'
complete -c nyxr -n '__fish_seen_subcommand_from probe; and __fish_seen_subcommand_from import' -F

# serve
complete -c nyxr -n '__fish_seen_subcommand_from serve' -l listen -x -d 'Listen address'
complete -c nyxr -n '__fish_seen_subcommand_from serve' -l db -r -F -d 'SQLite database for scans and results'
complete -c nyxr -n '__fish_seen_subcommand_from serve' -l packetd -r -F -d 'nyxr-packetd Unix socket'
complete -c nyxr -n '__fish_seen_subcommand_from serve' -l evidence-dir -r -a '(__fish_complete_directories)' -d 'Directory for API pcapng captures'
complete -c nyxr -n '__fish_seen_subcommand_from serve' -l token-file -r -F -d 'Require this bearer token'
complete -c nyxr -n '__fish_seen_subcommand_from serve' -l max-scans -x -d 'Concurrent scans'
complete -c nyxr -n '__fish_seen_subcommand_from serve' -l allow-privileged -d 'Run even with root or raw-socket capabilities'
complete -c nyxr -n '__fish_seen_subcommand_from serve' -l help -d 'Show serve help'

# history
complete -c nyxr -n '__fish_seen_subcommand_from history' -l db -r -F -d 'SQLite database written by nyxr scan --db'
complete -c nyxr -n '__fish_seen_subcommand_from history' -l scan -x -d 'Print the observations and packet evidence of one scan'
complete -c nyxr -n '__fish_seen_subcommand_from history' -l assets -d 'Print every address with the latest state of each port'
complete -c nyxr -n '__fish_seen_subcommand_from history' -l unknown -d 'Print service observations with an unknown fingerprint'
complete -c nyxr -n '__fish_seen_subcommand_from history' -l address -x -d 'Restrict --scan or --unknown to one address'
complete -c nyxr -n '__fish_seen_subcommand_from history' -l limit -x -d 'Maximum scans or observations'
complete -c nyxr -n '__fish_seen_subcommand_from history' -l prune-older-than -x -d 'Delete scans older than this duration (e.g. 720h)'
complete -c nyxr -n '__fish_seen_subcommand_from history' -l keep -x -d 'Delete all but the newest N scans'
complete -c nyxr -n '__fish_seen_subcommand_from history' -l json -d 'JSON output'
complete -c nyxr -n '__fish_seen_subcommand_from history' -l help -d 'Show history help'

# completion
complete -c nyxr -n '__fish_seen_subcommand_from completion' -x -a 'bash zsh fish powershell'
