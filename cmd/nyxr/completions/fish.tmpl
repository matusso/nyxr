# fish completion for nyxr
#
# Load in the current shell:   nyxr completion fish | source
# Load for every new shell:    nyxr completion fish > ~/.config/fish/completions/nyxr.fish

function __nyxr_profiles
{{- range .Profiles}}
    printf '%s\t%s\n' {{fish .Name}} {{fish .Description}}
{{- end}}
end

set -l __nyxr_commands scan profiles decode sniff completion version help
complete -c nyxr -f

complete -c nyxr -n "not __fish_seen_subcommand_from $__nyxr_commands" -a scan -d 'Run a scan'
complete -c nyxr -n "not __fish_seen_subcommand_from $__nyxr_commands" -a profiles -d 'List scan profiles'
complete -c nyxr -n "not __fish_seen_subcommand_from $__nyxr_commands" -a decode -d 'Decode an Ethernet pcap to JSON'
complete -c nyxr -n "not __fish_seen_subcommand_from $__nyxr_commands" -a sniff -d 'Capture and decode live frames'
complete -c nyxr -n "not __fish_seen_subcommand_from $__nyxr_commands" -a completion -d 'Print a shell completion script'
complete -c nyxr -n "not __fish_seen_subcommand_from $__nyxr_commands" -a version -d 'Print the version'
complete -c nyxr -n "not __fish_seen_subcommand_from $__nyxr_commands" -a help -d 'Show help'

# scan
complete -c nyxr -n '__fish_seen_subcommand_from scan' -l profile -x -a '(__nyxr_profiles)' -d 'Scan profile'
complete -c nyxr -n '__fish_seen_subcommand_from scan' -l ports -x -a {{fish (join .PortSets " ")}} -d 'Ports, ranges, or a named set'
complete -c nyxr -n '__fish_seen_subcommand_from scan' -l protocols -x -a 'tcp udp icmp tcp,udp tcp,icmp udp,icmp tcp,udp,icmp' -d 'Comma list of protocols'
complete -c nyxr -n '__fish_seen_subcommand_from scan' -l timeout -x -d 'Per-probe timeout (e.g. 1s, 750ms)'
complete -c nyxr -n '__fish_seen_subcommand_from scan' -l rate -x -d 'Max probes per second (0 = unlimited)'
complete -c nyxr -n '__fish_seen_subcommand_from scan' -l workers -x -d 'Concurrent probe workers'
complete -c nyxr -n '__fish_seen_subcommand_from scan' -l udp-retries -x -a '0 1 2 3 4 5' -d 'Extra retries per UDP probe'
complete -c nyxr -n '__fish_seen_subcommand_from scan' -l payload -r -F -d 'Native YAML UDP probe definition'
complete -c nyxr -n '__fish_seen_subcommand_from scan' -l send-hex -x -d 'Custom UDP payload as hex'
complete -c nyxr -n '__fish_seen_subcommand_from scan' -l send-base64 -x -d 'Custom UDP payload as base64'
complete -c nyxr -n '__fish_seen_subcommand_from scan' -l payload-file -r -F -d 'Custom raw UDP payload file'
complete -c nyxr -n '__fish_seen_subcommand_from scan' -l config -r -F -d 'YAML scan configuration'
complete -c nyxr -n '__fish_seen_subcommand_from scan' -l json -d 'Newline-delimited JSON output'
complete -c nyxr -n '__fish_seen_subcommand_from scan' -l dry-run -d 'Print the plan without sending packets'
complete -c nyxr -n '__fish_seen_subcommand_from scan' -l help -d 'Show scan help'

# profiles
complete -c nyxr -n '__fish_seen_subcommand_from profiles' -l json -d 'JSON output'

# decode
complete -c nyxr -n '__fish_seen_subcommand_from decode' -F

# sniff
complete -c nyxr -n '__fish_seen_subcommand_from sniff' -l interface -x -a '(__fish_print_interfaces)' -d 'Network interface'
complete -c nyxr -n '__fish_seen_subcommand_from sniff' -l count -x -d 'Number of decoded packets'
complete -c nyxr -n '__fish_seen_subcommand_from sniff' -l timeout -x -d 'Capture duration'

# completion
complete -c nyxr -n '__fish_seen_subcommand_from completion' -x -a 'bash zsh fish powershell'
